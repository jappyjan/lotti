{
  "name": "wisp-fw",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/wisp-fw/src",
  "tags": ["lang:c", "platform:apollo510", "wisp"],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": { "command": "apps/wisp-fw/scripts/setup.sh" },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["setup"],
      "options": { "command": "apps/wisp-fw/scripts/build.sh" },
      "cache": false
    },
    "sim": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "apps/wisp-fw/scripts/sim.sh" },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "apps/wisp-fw/scripts/test.sh" },
      "cache": false
    }
  }
}
