/* SPDX-License-Identifier: MIT
 * wisp_g2 with the JBD4010 panel (stock hw_version 5, DVT2; Jan's temples report hardware 5):
 * rails BUCK1 1.1 V + LDSW2, GPIO142 and GPIO68, stock offset (12, 10). BUCK1 1.1 V is written as
 * code 0x01, the value W21 read on the left temple (images/pmic-baseline-w21.json; the volts are [I]).
 * Hardware images keep the panel off for now (cmake/hwimage.cmake); the pattern is native-1. */
&pmic_buck1 {
	regulator-min-microvolt = <1100000>;
	regulator-max-microvolt = <1100000>;
};

&uled {
	panel = "jbd4010";
	vio-supply = <&pmic_ldsw2>;
	/delete-property/ en-b-gpios;
	en-c-gpios = <&gpio64_95 4 GPIO_ACTIVE_HIGH>; /* GPIO68 */
	offset-x = <12>;
	offset-y = <10>;
};
