CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# Link at the code partition (0x438000, where the Even bootloader hands off), not at the
# start of flash0 (0x410000, the Even bootloader itself).
CONFIG_USE_DT_CODE_PARTITION=y

# Bluetooth stays off until the EM9305 no-reflash patch exists (safety rule 8, milestone M6).
CONFIG_BT=n
