<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Stay connected to the glasses with the phone locked; record from the phone mic as a fallback. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>audio</string>
	</array>
	<key>NSAlarmKitUsageDescription</key>
	<string>Lotti sets timers when you confirm them on the glasses.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Lotti reads your reminders and adds new ones when you confirm them on the glasses.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lotti talks to your Hermes on your network.</string>
	<!-- Hermes may run on the local network or a tailnet without HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
