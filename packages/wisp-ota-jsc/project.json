{
  "name": "wisp-ota-jsc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/wisp-ota-jsc/src",
  "tags": ["lang:ts", "platform:portable", "scope:wisp"],
  "implicitDependencies": ["wisp-ota"],
  "namedInputs": {
    "bundleSources": [
      "{projectRoot}/src/**/*",
      "!{projectRoot}/src/**/*.test.ts",
      "{projectRoot}/scripts/bundle.mjs",
      "{workspaceRoot}/packages/wisp-ota/src/**/*",
      "!{workspaceRoot}/packages/wisp-ota/src/**/*.test.ts",
      { "externalDependencies": ["esbuild"] }
    ]
  },
  "targets": {
    "bundle": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/bundle.mjs",
        "cwd": "packages/wisp-ota-jsc"
      },
      "inputs": ["bundleSources"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p tsconfig.json --noEmit",
          "tsc -p tsconfig.portable.json --noEmit"
        ],
        "parallel": false,
        "cwd": "packages/wisp-ota-jsc"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig*.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/packages/wisp-ota/src/**/*",
        { "externalDependencies": ["typescript", "@types/node"] }
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["bundle"],
      "options": {
        "commands": [
          "node scripts/build-tests.mjs",
          "node --test --test-force-exit \"out-tsc/*.test.mjs\""
        ],
        "parallel": false,
        "cwd": "packages/wisp-ota-jsc"
      },
      "inputs": [
        "bundleSources",
        "{projectRoot}/src/**/*",
        "{projectRoot}/scripts/*"
      ],
      "cache": true
    }
  }
}
